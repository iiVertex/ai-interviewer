# Copy to .env (repo root) for the FastAPI server. Never commit the real file.

# Supabase project (Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# CometAPI (https://www.cometapi.com) - one key for Whisper, TTS and Claude
COMETAPI_KEY=sk-...
COMETAPI_BASE_URL=https://api.cometapi.com

# Models (defaults shown)
STT_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
CONTENT_MODEL=claude-haiku-5-5
QUESTION_MODEL=claude-haiku-5-5

# Feature switches
ENABLE_JD_QUESTIONS=false
DEFAULT_DAILY_LIMIT=5
